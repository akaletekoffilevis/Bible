@namespace BibleApp.Layout
@using System
@using MudBlazor
@inherits LayoutComponentBase
@inject BibleApp.Services.ThemeService ThemeService
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime
@inject ISnackbar Snackbar
@implements IDisposable

<MudThemeProvider Theme="_theme" IsDarkMode="ThemeService.IsDarkMode" @key="ThemeService.IsDarkMode" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

    <MudLayout>
    <MudAppBar Elevation="0" Style="border-bottom:1px solid var(--mud-palette-divider); backdrop-filter:blur(8px);">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Default" OnClick="@((e) => DrawerToggle())" Size="Size.Medium" />
        @if (_showBackButton)
        {
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Default" OnClick="@(() => Navigation.NavigateTo(_backUrl))" Size="Size.Medium" />
        }
        <MudText Typo="Typo.subtitle1" Class="ml-2 font-weight-bold" Style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width: 60vw;">@_pageTitle</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Default" href="/recherche" Size="Size.Medium" />
        <MudIconButton Icon="@Icons.Material.Filled.BookmarkBorder" Color="Color.Default" href="/favoris" Size="Size.Medium" />
        <MudIconButton Icon="@Icons.Material.Filled.DarkMode" Color="Color.Default" OnClick="@(() => ThemeService.Toggle())" Size="Size.Medium" />
    </MudAppBar>

    <MudDrawer Open="_drawerOpen" OpenChanged="OnDrawerOpenChanged" Variant="_drawerVariant" Width="360px" ClipMode="@(_drawerVariant == DrawerVariant.Temporary ? DrawerClipMode.Never : DrawerClipMode.Always)">
        <div class="d-flex align-center drawer-close-bar" Style="justify-content:flex-end;">
            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" OnClick="@(() => CloseDrawer())" Size="Size.Small" />
        </div>
        <NavMenu OnNavigated="OnNavMenuNavigated" />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Medium" Class="py-4 px-sm-4 px-2">
            @Body
        </MudContainer>
    </MudMainContent>

    <!-- Bottom navigation (mobile only) -->
    <nav class="mobile-bottom-nav" aria-label="Navigation mobile">
        <a href="/" class="mbn-item">
            <span class="material-icons">home</span>
            <span>Accueil</span>
        </a>
        <a href="/recherche" class="mbn-item">
            <span class="material-icons">search</span>
            <span>Recherche</span>
        </a>
        <a href="/memorisation" class="mbn-item">
            <span class="material-icons">style</span>
            <span>Memoriser</span>
        </a>
        <a href="/concordance" class="mbn-item">
            <span class="material-icons">library_books</span>
            <span>Themes</span>
        </a>
        <button class="mbn-item" @onclick="DrawerToggle">
            <span class="material-icons">menu</span>
            <span>Menu</span>
        </button>
    </nav>
</MudLayout>

@if (_showConsent)
{
    <MudPaper Style="position:fixed; bottom:0; left:0; right:0; z-index:9999; border-radius:0;" Elevation="5" Class="pa-3">
        <div class="d-flex align-center" style="gap:12px; flex-wrap:wrap;">
            <MudText Typo="Typo.caption" Class="flex-grow-1" Style="line-height:1.5;">
                Bibeli utilise uniquement des données locales. Google Translate (optionnel) charge depuis Google.
                <MudLink Href="/parametres" Typo="Typo.caption">En savoir plus</MudLink>
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="@AccepterConsent">OK</MudButton>
        </div>
    </MudPaper>
}

@code {
    private bool _drawerOpen = true;
    private bool _showBackButton;
    private string _backUrl = "/";
    private string _pageTitle = "Bible Louis Segond";
    private DrawerVariant _drawerVariant = DrawerVariant.Persistent;
    private bool _showConsent;
    private MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#2563eb",
            Secondary = "#0ea5e9",
            AppbarBackground = "#ffffff",
            Surface = "#ffffff",
            Background = "#f1f5f9",
            TextPrimary = "#0f172a",
            TextSecondary = "#475569",
            DrawerBackground = "#ffffff",
            DrawerText = "#0f172a",
            Divider = "#e2e8f0",
            ActionDefault = "#475569"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#60a5fa",
            Secondary = "#38bdf8",
            AppbarBackground = "#0f172a",
            Surface = "#1e293b",
            Background = "#0b1120",
            TextPrimary = "#f1f5f9",
            TextSecondary = "#94a3b8",
            Dark = "#1e293b",
            DrawerBackground = "#0f172a",
            DrawerText = "#f1f5f9",
            Divider = "#1e293b"
        }
    };

    protected override void OnInitialized()
    {
        ThemeService.OnChange += OnThemeChanged;
        Navigation.LocationChanged += OnLocationChanged;
        UpdateBackButton(Navigation.Uri);
    }

    private async void OnThemeChanged()
    {
        try
        {
            StateHasChanged();
            await JsRuntime.InvokeVoidAsync("bibleUtils.applyTheme", ThemeService.IsDarkMode);
        }
        catch (Exception ex) { Console.Error.WriteLine($"[Layout] Échec application thème: {ex.Message}"); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var width = await JsRuntime.InvokeAsync<double>("bibleUtils.getWindowWidth");
            _drawerOpen = width > 960;
            _drawerVariant = width > 960 ? DrawerVariant.Persistent : DrawerVariant.Temporary;
            var consent = await JsRuntime.InvokeAsync<string?>("bibleUtils.localStorageGet", "consent");
            _showConsent = consent != "true";

            // Appliquer les préférences utilisateur globalement
            var dm = await JsRuntime.InvokeAsync<string?>("bibleUtils.localStorageGet", "darkMode");
            if (dm == "true" != ThemeService.IsDarkMode) ThemeService.SetDarkMode(dm == "true");
            var fs = await JsRuntime.InvokeAsync<string?>("bibleUtils.localStorageGet", "fontSize");
            var ff = await JsRuntime.InvokeAsync<string?>("bibleUtils.localStorageGet", "fontFamily");
            var lh = await JsRuntime.InvokeAsync<string?>("bibleUtils.localStorageGet", "lineHeight");
            await JsRuntime.InvokeVoidAsync("bibleUtils.setBodyStyles",
                (fs ?? "18") + "px", ff ?? "serif", lh ?? "2");

            StateHasChanged();
            _ = VerifierInstallationPwaAsync();
        }
    }

    private async Task AccepterConsent()
    {
        _showConsent = false;
        try { await JsRuntime.InvokeVoidAsync("bibleUtils.localStorageSet", "consent", "true"); }
        catch (Exception ex) { Console.Error.WriteLine($"[Layout] Échec sauvegarde consent: {ex.Message}"); }
        Snackbar.Add("Préférences enregistrées", Severity.Success);
        StateHasChanged();
    }

    private async Task VerifierInstallationPwaAsync()
    {
        try
        {
            var alreadyInstalled = await JsRuntime.InvokeAsync<bool>("bibleInstall.isInstalled");
            if (alreadyInstalled) return;

            // Check si l'installation est disponible (beforeinstallprompt already fired)
            await Task.Delay(5_000);
            var installable = await JsRuntime.InvokeAsync<bool>("bibleInstall.isInstallable");
            if (installable)
            {
                Snackbar.Add("Installe Bibeli pour une expérience hors-ligne", Severity.Info, config =>
                {
                    config.Action = "Installer";
                    config.ActionColor = Color.Primary;
                    config.OnClick = async _ =>
                    {
                        await JsRuntime.InvokeVoidAsync("bibleInstall.promptInstall");
                    };
                    config.VisibleStateDuration = 15000;
                    config.ShowCloseIcon = true;
                });
            }
        }
        catch (Exception ex) { Console.Error.WriteLine($"[PWA] Échec vérification installation: {ex.Message}"); }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateBackButton(e.Location);
        if (_drawerVariant == DrawerVariant.Temporary)
            _drawerOpen = false;
        StateHasChanged();
    }

    private void UpdateBackButton(string location)
    {
        var uri = new Uri(location);
        var path = uri.AbsolutePath.Trim('/');

        if (string.IsNullOrEmpty(path) || path == "/" || path == "index.html")
        {
            _showBackButton = false;
            _backUrl = "/";
            _pageTitle = "Bible Louis Segond";
        }
        else if (path.StartsWith("lecture/"))
        {
            _showBackButton = true;
            _backUrl = "/";
            _pageTitle = "Lecture";
        }
        else if (path.StartsWith("livre-chapitres/"))
        {
            _showBackButton = true;
            _backUrl = "/";
            _pageTitle = "Chapitres";
        }
        else
        {
            _showBackButton = true;
            _backUrl = "/";
            _pageTitle = path switch
            {
                "recherche" => "Recherche",
                "reference" => "Navigation rapide",
                "favoris" => "Favoris",
                "progression" => "Progression",
                "plan-lecture" => "Plan de lecture",
                "quiz" => "Quiz biblique",

                "parametres" => "Paramètres",
                _ => "Bible Louis Segond"
            };
        }
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
        StateHasChanged();
    }

    private void OnDrawerOpenChanged(bool value)
    {
        _drawerOpen = value;
        StateHasChanged();
    }

    private void OnNavMenuNavigated()
    {
        if (_drawerVariant == DrawerVariant.Temporary)
        {
            _drawerOpen = false;
            StateHasChanged();
        }
    }

    private void CloseDrawer()
    {
        _drawerOpen = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        ThemeService.OnChange -= OnThemeChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
