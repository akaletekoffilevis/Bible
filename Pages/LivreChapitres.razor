@page "/livre-chapitres/{Slug}"
@using BibleApp.Models
@inject BibleApp.Services.BibleService BibleService
@inject IJSRuntime JsRuntime

<MudText Typo="Typo.h6" Class="mb-0 font-weight-bold">@_livre?.NomLivre</MudText>
<MudText Typo="Typo.caption" Class="mb-3 mud-text-secondary d-flex align-center" Style="gap:4px;">
    <MudIcon Icon="@Icons.Material.Filled.AutoStories" Size="Size.Small" />
    @_livre?.ContenuChapitre.Count chapitres
</MudText>

@if (_dernierChapitre > 0)
{
    <MudPaper Class="mb-3 pa-3" Style="border-left: 4px solid var(--mud-palette-primary); border-radius: 8px; cursor:pointer;">
        <div @onclick="@(() => NavigateTo(_dernierChapitre))" class="d-flex align-center justify-space-between">
            <MudText Typo="Typo.body2" Color="Color.Primary" Class="font-weight-medium">
                Reprendre — Chapitre @_dernierChapitre
            </MudText>
            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Color="Color.Primary" />
        </div>
    </MudPaper>
}

@if (_livre == null)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Indeterminate />
    </div>
}
else
{
    <MudPaper Class="pa-3" Elevation="0" Style="border-radius: 8px;">
        <MudGrid>
            @foreach (var chapitre in _livre.ContenuChapitre)
            {
                <MudItem xs="3" sm="2" md="1">
                    <MudButton Variant="@(chapitre.Numero == _dernierChapitre ? Variant.Filled : Variant.Outlined)"
                               Color="@(chapitre.Numero == _dernierChapitre ? Color.Primary : Color.Default)"
                               FullWidth="true"
                               Class="mb-2"
                               OnClick="@(() => NavigateTo(chapitre.Numero))"
                               Style="border-radius: 6px; min-height: 40px;">
                        @chapitre.Numero
                    </MudButton>
                </MudItem>
            }
        </MudGrid>
    </MudPaper>
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private Livre? _livre;
    private int _dernierChapitre;

    protected override async Task OnInitializedAsync()
    {
        _livre = await BibleService.GetLivreAsync(Slug);
        try
        {
            var pos = await JsRuntime.InvokeAsync<string>("bibleUtils.localStorageGet", $"lastPos-{Slug}");
            if (int.TryParse(pos, out var chap) && chap > 0)
                _dernierChapitre = chap;
        }
        catch { }
    }

    private void NavigateTo(int chapitre)
    {
        NavigationManager.NavigateTo($"/lecture/{Slug}/{chapitre}");
    }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = null!;
}
