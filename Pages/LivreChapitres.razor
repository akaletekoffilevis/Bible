@page "/livre-chapitres/{Slug}"
@using BibleApp.Models
@inject BibleApp.Services.BibleService BibleService
@inject IJSRuntime JsRuntime

<Breadcrumb Nodes="@(new List<BreadcrumbNode> {
    new() { Label = "Accueil", Href = "/", Icon = Icons.Material.Filled.Home },
    new() { Label = _livre?.NomLivre ?? "..." }
})" />

<MudPaper Class="pa-4 mb-4" Elevation="0" Style="border-radius:12px; background: linear-gradient(135deg, var(--mud-palette-primary) 0%, var(--mud-palette-secondary) 100%); color:white;">
    <div class="d-flex align-center justify-space-between">
        <div>
            <MudText Typo="Typo.h5" Class="font-weight-bold mb-1">@_livre?.NomLivre</MudText>
            <MudText Typo="Typo.body2" Style="opacity:0.9;">
                <MudIcon Icon="@Icons.Material.Filled.AutoStories" Size="Size.Small" Class="mr-1" />
                @_livre?.ContenuChapitre.Count chapitres
                @if (_dernierChapitre > 0)
                {
                    <span class="ml-3">• Dernier : Chapitre @_dernierChapitre</span>
                }
            </MudText>
        </div>
        <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Large" Style="opacity:0.3; font-size:3rem;" />
    </div>
</MudPaper>

@if (_dernierChapitre > 0)
{
    <MudPaper Class="mb-3" Style="border-radius:10px; cursor:pointer; overflow:hidden;" Elevation="0">
        <div @onclick="@(() => NavigateTo(_dernierChapitre))" class="d-flex align-center pa-3" Style="border-left:4px solid var(--mud-palette-primary);">
            <div class="flex-grow-1">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Reprendre la lecture</MudText>
                <MudText Typo="Typo.body2" Color="Color.Primary" Class="font-weight-medium">Chapitre @_dernierChapitre</MudText>
            </div>
            <MudPaper Class="d-flex align-center justify-center" Style="width:40px; height:40px; border-radius:50%; background:var(--mud-palette-primary); color:white;">
                <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" />
            </MudPaper>
        </div>
    </MudPaper>
}

@if (_livre == null)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Indeterminate />
    </div>
}
else
{
    <MudText Typo="Typo.subtitle2" Class="mb-2 mud-text-secondary">Choisis un chapitre</MudText>
    <div class="chapitre-grid">
        @foreach (var chapitre in _livre.ContenuChapitre)
        {
            var isLast = chapitre.Numero == _dernierChapitre;
            <div @onclick="@(() => NavigateTo(chapitre.Numero))" class="chapitre-card @(isLast ? "chapitre-card--active" : "")" role="button" tabindex="0" aria-label="Chapitre @chapitre.Numero">
                <span class="chapitre-num">@chapitre.Numero</span>
                @if (isLast)
                {
                    <span class="chapitre-badge">Lu</span>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private Livre? _livre;
    private int _dernierChapitre;

    protected override async Task OnInitializedAsync()
    {
        _livre = await BibleService.GetLivreAsync(Slug);
        try
        {
            var pos = await JsRuntime.InvokeAsync<string>("bibleUtils.localStorageGet", $"lastPos-{Slug}");
            if (int.TryParse(pos, out var chap) && chap > 0)
                _dernierChapitre = chap;
        }
        catch { }
    }

    private void NavigateTo(int chapitre)
    {
        NavigationManager.NavigateTo($"/lecture/{Slug}/{chapitre}");
    }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = null!;
}
