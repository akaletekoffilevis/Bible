@page "/parametres"
@using BibleApp.Models
@using MudBlazor
@inject IJSRuntime JsRuntime
@inject BibleApp.Services.ThemeService ThemeService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<Breadcrumb Nodes="@(new List<BreadcrumbNode> {
    new() { Label = "Accueil", Href = "/", Icon = Icons.Material.Filled.Home },
    new() { Label = "Paramètres" }
})" />

<MudText Typo="Typo.h6" Class="mb-4 font-weight-bold d-flex align-center">
    <MudIcon Icon="@Icons.Material.Filled.Settings" Class="mr-2" /> Paramètres
</MudText>

<MudExpansionPanels>
