        <div class="d-flex align-center justify-space-between mb-3">
            <MudText Typo="Typo.body2">Mode nuit</MudText>
            <MudSwitch @bind-Value="_isDark" @bind-Value:after="OnIsDarkChanged" Color="Color.Primary" />
        </div>

        <MudText Typo="Typo.body2" Class="mb-1">Taille de police</MudText>
        <MudSlider @bind-Value="_fontSize" @bind-Value:after="OnFontSizeChanged" Min="14" Max="28" Step="2" Class="mb-1" />
        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-3 d-block">@_fontSize px</MudText>

        <MudText Typo="Typo.body2" Class="mb-1">Famille de police</MudText>
        <MudSelect T="string" @bind-Value="_fontFamily" @bind-Value:after="OnFontFamilyChanged" Variant="Variant.Outlined" Dense="true" Immediate="true" Class="mb-3">
            <MudSelectItem Value="@("serif")">Serif (défaut)</MudSelectItem>
            <MudSelectItem Value="@("sans-serif")">Sans-serif</MudSelectItem>
            <MudSelectItem Value="@("Georgia, serif")">Georgia</MudSelectItem>
        </MudSelect>

        <MudText Typo="Typo.body2" Class="mb-1">Interlignage</MudText>
        <MudSlider @bind-Value="_lineHeight" @bind-Value:after="OnLineHeightChanged" Min="1.5" Max="2.8" Step="0.1" Class="mb-1" />
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@_lineHeight.ToString("0.0")</MudText>
    </MudExpansionPanel>

    <MudExpansionPanel Text="Traduction" Class="mb-2">
        <div class="d-flex align-center justify-space-between mb-2">
            <div>
                <MudText Typo="Typo.body2">Google Translate</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Traduit l'interface en 11 langues</MudText>
            </div>
            <MudSwitch @bind-Value="_showTranslate" @bind-Value:after="OnShowTranslateChanged" Color="Color.Secondary" />
        </div>
    </MudExpansionPanel>

    <MudExpansionPanel Text="Espace de stockage" Class="mb-2">
        <MudText Typo="Typo.body2" Class="mb-1">Données locales</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-3 d-block">
            Les marque-pages, notes et la progression sont stockés dans le navigateur.
        </MudText>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="@EffacerDonnees" Size="Size.Small">
            Effacer les données locales
        </MudButton>
    </MudExpansionPanel>

    <MudExpansionPanel Text="À propos de Bibeli" Class="mb-2" Expanded="true">
        <MudText Typo="Typo.body2" Class="mb-1">Bibeli — Bible Louis Segond (LSG)</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2 d-block" Style="line-height:1.6;">
            Bibeli est une application PWA gratuite et hors-ligne pour lire, étudier et partager la Bible Louis Segond en français.
            Elle offre la lecture chapitre par chapitre, la recherche plein texte dans les 66 livres, un quiz biblique pour tester vos connaissances,
            une carte des lieux bibliques, des marque-pages, des notes personnelles, la génération d'images de versets,
            et la lecture audio (TTS). Toutes les données sont stockées localement dans votre navigateur.
            Aucune donnée personnelle n'est collectée ni transmise à un serveur tiers.
        </MudText>
        <MudText Typo="Typo.caption" Class="mb-1">
            Créé par <strong>AKALETE Koffi Levis</strong>
        </MudText>
        <MudLink Href="mailto:koffilevis21@gmail.com" Typo="Typo.caption" Class="d-block mb-1">
            <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Class="mr-1" /> koffilevis21@gmail.com
        </MudLink>
        <MudLink Href="https://wa.me/22791535220" Target="_blank" Typo="Typo.caption" Class="d-block mb-1">
            <MudIcon Icon="@Icons.Material.Filled.Chat" Size="Size.Small" Class="mr-1" /> +227 91 53 52 20 (WhatsApp)
        </MudLink>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            Version 2.0 — .NET 9 &bull; MudBlazor &bull; PWA
        </MudText>
    </MudExpansionPanel>

    <MudExpansionPanel Text="Confidentialité" Class="mb-2" Expanded="true">
        <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="line-height:1.6;">
            <strong>Bibeli</strong> respecte votre vie privée. Aucune donnée personnelle n'est collectée, stockée ou transmise à un serveur tiers.
            <br /><br />
            <strong>Données locales :</strong> Les marque-pages, notes, progression de lecture et préférences (thème, taille de police) sont stockés
            exclusivement dans votre navigateur via IndexedDB et localStorage. Ces données ne quittent jamais votre appareil.
            <br /><br />
            <strong>Données de la Bible :</strong> Les textes bibliques (Louis Segond) sont chargés depuis le serveur d'hébergement (Vercel)
            et mis en cache par le service worker pour une utilisation hors-ligne. Aucune lecture individuelle n'est suivie.
            <br /><br />
            <strong>Traduction Google :</strong> Si vous activez Google Translate dans les paramètres, le script de Google est chargé
            depuis leurs serveurs et est soumis à leur politique de confidentialité.
            <br /><br />
            <strong>Aucun cookie</strong> tiers n'est utilisé à des fins de traçage ou de publicité.
            <br /><br />
            Pour toute question, contactez-nous :
            <MudLink Href="mailto:koffilevis21@gmail.com" Typo="Typo.caption">koffilevis21@gmail.com</MudLink>
