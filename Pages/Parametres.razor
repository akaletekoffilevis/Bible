            Bibeli est fournie "telle quelle". Le créateur ne peut être tenu responsable des dommages directs ou indirects
            résultant de l'utilisation de l'application.
            <br /><br />
            <strong>6. Contact</strong><br />
            AKALETE Koffi Levis &mdash; <MudLink Href="https://wa.me/22791535220" Target="_blank" Typo="Typo.caption">+227 91 53 52 20</MudLink>
        </MudText>
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    private int _fontSize = 18;
    private string _fontFamily = "serif";
    private double _lineHeight = 2.0;
    private bool _showTranslate;
    private bool _isDark;

    protected override async Task OnInitializedAsync()
    {
        var fs = await GetSettingAsync("fontSize");
        if (int.TryParse(fs, out var parsed)) _fontSize = parsed;
        _fontFamily = await GetSettingAsync("fontFamily") ?? "serif";
        var lh = await GetSettingAsync("lineHeight");
        if (double.TryParse(lh, out var parsedLh)) _lineHeight = parsedLh;
        _showTranslate = await GetSettingAsync("showTranslate") == "true";
        _isDark = await GetSettingAsync("darkMode") == "true";

        if (_isDark != ThemeService.IsDarkMode)
            ThemeService.SetDarkMode(_isDark);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ApplyStylesAsync();
            if (_showTranslate)
                await JsRuntime.InvokeVoidAsync("bibleUtils.toggleGoogleTranslate", true);
        }
    }

    private async Task OnIsDarkChanged()
    {
        ThemeService.SetDarkMode(_isDark);
        await SetSettingAsync("darkMode", _isDark.ToString().ToLower());
    }

    private async Task OnShowTranslateChanged()
    {
        await SetSettingAsync("showTranslate", _showTranslate.ToString().ToLower());
        await JsRuntime.InvokeVoidAsync("bibleUtils.toggleGoogleTranslate", _showTranslate);
    }

    private async Task OnFontSizeChanged()
    {
        await ApplyStylesAsync();
        await SetSettingAsync("fontSize", _fontSize.ToString());
    }

    private async Task OnFontFamilyChanged()
    {
        await ApplyStylesAsync();
        await SetSettingAsync("fontFamily", _fontFamily);
    }

    private async Task OnLineHeightChanged()
    {
        await ApplyStylesAsync();
        await SetSettingAsync("lineHeight", _lineHeight.ToString("0.0"));
    }

    private async Task ApplyStylesAsync()
    {
        await JsRuntime.InvokeVoidAsync("bibleUtils.setBodyStyles",
            $"{_fontSize}px", _fontFamily, $"{_lineHeight}");
    }

    private async Task EffacerDonnees()
    {
        var confirm = await DialogService.ShowMessageBox(
            "Effacer les données ?",
            "Toutes les données locales (marque-pages, notes, progression, préférences) seront supprimées. Cette action est irréversible.",
            yesText: "Oui, effacer",
            cancelText: "Annuler");
        if (confirm != true) return;

        await JsRuntime.InvokeVoidAsync("bibleUtils.localStorageClear");
        await JsRuntime.InvokeVoidAsync("bibleUtils.clearIndexedDB");
        _isDark = false;
        _fontSize = 18;
        _fontFamily = "serif";
        _lineHeight = 2.0;
        _showTranslate = false;
        ThemeService.SetDarkMode(false);
        await ApplyStylesAsync();
        Snackbar.Add("Données effacées", Severity.Success);
        StateHasChanged();
    }

    private async Task<string?> GetSettingAsync(string key)
    {
        try { return await JsRuntime.InvokeAsync<string?>("bibleUtils.localStorageGet", key); }
        catch { return null; }
    }

    private async Task SetSettingAsync(string key, string value)
    {
        try { await JsRuntime.InvokeVoidAsync("bibleUtils.localStorageSet", key, value); }
        catch { }
    }
}
