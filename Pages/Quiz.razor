@page "/quiz"
@using BibleApp.Models
@inject BibleApp.Services.BibleService BibleService

<Breadcrumb Nodes="@(new List<BreadcrumbNode> {
    new() { Label = "Accueil", Href = "/", Icon = Icons.Material.Filled.Home },
    new() { Label = "Quiz biblique" }
})" />

<MudText Typo="Typo.h6" Class="mb-4 font-weight-bold d-flex align-center">
    <MudIcon Icon="@Icons.Material.Filled.Quiz" Class="mr-2" /> Quiz biblique
</MudText>

@if (_questions.Count == 0 && !_generating)
{
    <MudPaper Class="pa-8 text-center" Elevation="0">
        <MudIcon Icon="@Icons.Material.Filled.Quiz" Size="Size.Large" Class="mud-text-secondary mb-4" />
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">Teste ta connaissance de la Bible avec ce quiz</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@Commencer" Size="Size.Large">
            Commencer le quiz
        </MudButton>
    </MudPaper>
}
else if (_generating)
{
    <div class="text-center pa-8">
        <MudProgressCircular Indeterminate Class="mb-4" />
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Génération des questions...</MudText>
    </div>
}
else if (_termine)
{
    <MudPaper Class="pa-6 text-center mb-4" Elevation="1" Style="border-radius: 12px;">
        <MudText Typo="Typo.h3" Class="mb-2 font-weight-bold">@_score / @_questions.Count</MudText>
        <MudProgressLinear Value="@((double)_score / _questions.Count * 100)" Color="@(_score == _questions.Count ? Color.Success : _score >= _questions.Count / 2 ? Color.Warning : Color.Error)" Class="mb-4" />
        <MudText Typo="Typo.body1" Class="mb-4">
            @if (_score == _questions.Count)
            {
                <span>Parfait ! Tu connais ta Bible sur le bout des doigts !</span>
            }
            else if (_score >= _questions.Count / 2)
            {
                <span>Bien joué ! Continue comme ça.</span>
            }
            else
            {
                <span>Continue à lire, tu vas progresser !</span>
            }
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@Recommencer">
            Recommencer
        </MudButton>
    </MudPaper>
}
else
{
    @if (_current != null)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="1" Style="border-radius: 8px;">
            <div class="d-flex align-center mb-1" style="gap:4px;">
                <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Class="mud-text-secondary" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary flex-grow-1">
                    Question @(_index + 1) / @_questions.Count
                </MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" OnClick="@Quitter" title="Abandonner le quiz" />
            </div>
            <div class="mb-3">
                <MudProgressLinear Value="@((double)(_index + 1) / _questions.Count * 100)" Color="Color.Primary" Size="Size.Small" />
            </div>
            <MudText Typo="Typo.body1" Class="mb-4 font-weight-medium" Style="line-height:1.6;">@_current.Texte</MudText>

            @foreach (var option in _current.Options)
            {
                <MudButton Variant="@(_repondu && option == _current.BonneReponse ? Variant.Filled : Variant.Outlined)"
                           Color="@(_repondu && option == _current.BonneReponse ? Color.Success : (_repondu && option == _selectionnee ? Color.Error : Color.Default))"
                           FullWidth="true"
                           Class="mb-2"
                           Disabled="@_repondu"
                           OnClick="@(() => Repondre(option))"
                           Style="border-radius: 8px; justify-content: flex-start; padding: 12px 16px; text-align: left;">
                    @option
                </MudButton>
            }

            @if (_repondu)
            {
                <MudPaper Class="pa-3 mt-3" Style="border-radius: 8px; background: var(--mud-palette-table-hover);">
                    <MudText Typo="Typo.body2" Class="mb-1">
                        @(_selectionnee == _current.BonneReponse ? "✅ Correct !" : $"❌ La réponse était : {_current.BonneReponse}")
                    </MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@_current.Reference</MudText>
                </MudPaper>
                <div class="text-right mt-3">
                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@Suivante" EndIcon="@Icons.Material.Filled.ChevronRight">
                        @(_index < _questions.Count - 1 ? "Suivante" : "Voir les résultats")
                    </MudButton>
                </div>
            }
        </MudPaper>
    }
}

@code {
    private List<Question> _questions = new();
    private int _index;
    private int _score;
    private string? _selectionnee;
    private bool _repondu;
    private bool _termine;
    private bool _generating;
    private Question? _current;

    private async Task Commencer()
    {
        _generating = true;
        _questions = await GenererQuestionsAsync();
        _generating = false;
        _current = _questions.FirstOrDefault();
    }

    private async Task<List<Question>> GenererQuestionsAsync()
    {
        var qs = new List<Question>();
        var rng = Random.Shared;
        var index = await BibleService.GetIndexAsync();

        for (int i = 0; i < 10; i++)
        {
            var bk = index[rng.Next(index.Count)];
            var livre = await BibleService.GetLivreAsync(bk.Slug);
            if (livre == null) continue;

            var chap = livre.ContenuChapitre[rng.Next(livre.ContenuChapitre.Count)];
            if (chap.ContenuVersets.Count < 2) continue;

            var v = chap.ContenuVersets[rng.Next(chap.ContenuVersets.Count)];
            var texte = v.TextePropre;
            var mots = texte.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (mots.Length < 8) continue;

            var motCache = mots[rng.Next(3, mots.Length - 3)];
            var phrase = texte.Replace(motCache, "______");

            var autresMots = new HashSet<string>();
            while (autresMots.Count < 3)
            {
                var bk2 = index[rng.Next(index.Count)];
                var l2 = await BibleService.GetLivreAsync(bk2.Slug);
                if (l2 == null) continue;
                var c2 = l2.ContenuChapitre[rng.Next(l2.ContenuChapitre.Count)];
                if (c2.ContenuVersets.Count == 0) continue;
                var v2 = c2.ContenuVersets[rng.Next(c2.ContenuVersets.Count)];
                var m = v2.TextePropre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                if (m.Length > 3)
                    autresMots.Add(m[rng.Next(m.Length)]);
            }

            var options = new List<string> { motCache };
            options.AddRange(autresMots.Take(3));
            options = options.OrderBy(_ => rng.Next()).ToList();

            qs.Add(new Question
            {
                Texte = $"Complète le verset : \"{phrase}\"",
                Options = options,
                BonneReponse = motCache,
                Reference = $"{livre.NomLivre} {chap.Numero}:{v.Numero}"
            });
        }

        return qs;
    }

    private void Repondre(string option)
    {
        if (_repondu) return;
        _selectionnee = option;
        _repondu = true;
        if (option == _current?.BonneReponse)
            _score++;
    }

    private void Suivante()
    {
        _index++;
        if (_index >= _questions.Count)
        {
            _termine = true;
            return;
        }
        _current = _questions[_index];
        _repondu = false;
        _selectionnee = null;
    }

    private void Quitter()
    {
        _index = 0;
        _score = 0;
        _termine = false;
        _repondu = false;
        _generating = false;
        _selectionnee = null;
        _current = null;
        _questions = new List<Question>();
    }

    private void Recommencer()
    {
        Quitter();
    }

    public class Question
    {
        public string Texte { get; set; } = string.Empty;
        public List<string> Options { get; set; } = new();
        public string BonneReponse { get; set; } = string.Empty;
        public string Reference { get; set; } = string.Empty;
    }
}
