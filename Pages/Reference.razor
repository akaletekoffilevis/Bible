@page "/reference"
@using BibleApp.Models
@inject BibleApp.Services.BibleService BibleService
@inject ISnackbar Snackbar

<Breadcrumb Nodes="@(new List<BreadcrumbNode> {
    new() { Label = "Accueil", Href = "/", Icon = Icons.Material.Filled.Home },
    new() { Label = "Navigation rapide" }
})" />

<MudText Typo="Typo.h6" Class="mb-4 font-weight-bold d-flex align-center">
    <MudIcon Icon="@Icons.Material.Filled.NearMe" Class="mr-2" /> Navigation rapide
</MudText>

<MudPaper Class="pa-4 mb-4 text-center" Elevation="0" Style="border-radius:12px;">
    <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
        Saisis une référence biblique pour y accéder directement
    </MudText>

    <MudTextField @ref="_inputRef"
                  @bind-Value="_refText"
                  @bind-Value:after="Naviguer"
                  Label="Ex: Genèse 1:1, Jn 3:16, Ps 23, Mt 5:7"
                  Variant="Variant.Outlined"
                  Class="mb-3 ref-input"
                  Adornment="Adornment.End"
                  AdornmentIcon="@Icons.Material.Filled.ArrowForward"
                  Placeholder="Genèse 1:1"
                  FullWidth="true"
                  Style="font-size:1.2rem;" />

    <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">Exemples rapides :</MudText>
    <div class="ref-examples">
        @foreach (var ex in _exemples)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ref-example-chip" OnClick="@(() => Remplir(ex))">
                @ex
            </MudChip>
        }
    </div>
</MudPaper>

@if (_erreur != null)
{
    <MudPaper Class="pa-4 text-center" Elevation="0" Style="border-radius:12px;">
        <MudIcon Icon="@Icons.Material.Filled.SentimentDissatisfied" Size="Size.Large" Class="mud-text-secondary mb-2" />
        <MudText Typo="Typo.body2" Color="Color.Error">@_erreur</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
            Essaie avec le nom complet, l'abréviation, ou vérifie l'orthographe
        </MudText>
    </MudPaper>
}

@code {
    private MudBlazor.MudTextField<string>? _inputRef;
    private string _refText = string.Empty;
    private string? _erreur;

    private readonly string[] _exemples = [
        "Genèse 1:1", "Jean 3:16", "Psaumes 23", "Matthieu 5:7",
        "Jn 3:16", "Ps 23", "Gn 1:1", "Mt 5:7",
        "1 Co 13", "Es 53", "Ap 21", "Rm 8:28"
    ];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _inputRef != null)
        {
            await _inputRef.FocusAsync();
        }
    }

    private void Remplir(string ex)
    {
        _refText = ex;
        // @bind-Value:after déclenchera Naviguer() automatiquement
    }

    private void Naviguer()
    {
        _ = NaviguerAsync();
    }

    private async Task NaviguerAsync()
    {
        _erreur = null;
        var texte = _refText?.Trim() ?? "";
        if (string.IsNullOrEmpty(texte)) return;

        var url = await BibleService.ResolveReferenceAsync(texte);
        if (url != null)
        {
            NavigationManager.NavigateTo(url);
            return;
        }

        if (texte.Contains(' '))
        {
            var parts = texte.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            var dernierePart = parts[^1];
            if (int.TryParse(dernierePart, out var chapitre))
            {
                var livrePart = string.Join(" ", parts[..^1]);
                var slug = await BibleService.ResolveSlugAsync(livrePart);
                if (slug != null)
                {
                    NavigationManager.NavigateTo($"/lecture/{slug}/{chapitre}");
                    return;
                }
            }
        }

        var slugOnly = await BibleService.ResolveSlugAsync(texte);
        if (slugOnly != null)
        {
            NavigationManager.NavigateTo($"/lecture/{slugOnly}/1");
            return;
        }

        _erreur = $"Impossible de trouver : \"{texte}\"";
    }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = null!;
}
