@page "/enfant"
@using BibleApp.Models
@using BibleApp.Services
@inject BibleService BibleService
@inject NavigationManager Navigation

<Breadcrumb Nodes="@(new List<BreadcrumbNode> {
    new() { Label = "Accueil", Href = "/", Icon = Icons.Material.Filled.Home },
    new() { Label = "Mode enfant" }
})" />

<div style="text-align:center; margin-bottom:1.5rem;">
    <MudText Typo="Typo.h4" Class="font-weight-bold" Style="color:#1e3a8a;">Mode enfant</MudText>
    <MudText Typo="Typo.body1" Class="mud-text-secondary">Decouvre la Bible en t'amusant !</MudText>
</div>

<MudGrid>
    <MudItem xs="12" sm="6">
        <MudPaper Class="pa-6 text-center" Elevation="1" Style="border-radius:20px; cursor:pointer; background:linear-gradient(135deg,#fef3c7,#fde68a);" @onclick="@(() => Navigation.NavigateTo("/"))">
            <MudIcon Icon="@Icons.Material.Filled.AutoStories" Size="Size.Large" Style="font-size:4rem; color:#b45309;" />
            <MudText Typo="Typo.h6" Class="mt-2 font-weight-bold" Style="color:#92400e;">Lire un passage</MudText>
            <MudText Typo="Typo.body2" Style="color:#92400e;">Choisis un livre et un chapitre</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudPaper Class="pa-6 text-center" Elevation="1" Style="border-radius:20px; cursor:pointer; background:linear-gradient(135deg,#dbeafe,#bfdbfe);" @onclick="@(() => Navigation.NavigateTo("/memorisation"))">
            <MudIcon Icon="@Icons.Material.Filled.Style" Size="Size.Large" Style="font-size:4rem; color:#1e40af;" />
            <MudText Typo="Typo.h6" Class="mt-2 font-weight-bold" Style="color:#1e3a8a;">Memoriser</MudText>
            <MudText Typo="Typo.body2" Style="color:#1e3a8a;">Apprends des versets par coeur</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudPaper Class="pa-6 text-center" Elevation="1" Style="border-radius:20px; cursor:pointer; background:linear-gradient(135deg,#dcfce7,#bbf7d0);" @onclick="@(() => Navigation.NavigateTo("/quiz"))">
            <MudIcon Icon="@Icons.Material.Filled.Quiz" Size="Size.Large" Style="font-size:4rem; color:#166534;" />
            <MudText Typo="Typo.h6" Class="mt-2 font-weight-bold" Style="color:#166534;">Quiz</MudText>
            <MudText Typo="Typo.body2" Style="color:#166534;">Teste tes connaissances</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudPaper Class="pa-6 text-center" Elevation="1" Style="border-radius:20px; cursor:pointer; background:linear-gradient(135deg,#fce7f3,#fbcfe8);" @onclick="@(() => Navigation.NavigateTo("/concordance"))">
            <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Large" Style="font-size:4rem; color:#9d174d;" />
            <MudText Typo="Typo.h6" Class="mt-2 font-weight-bold" Style="color:#9d174d;">Themes</MudText>
            <MudText Typo="Typo.body2" Style="color:#9d174d;">Decouvre des versets par theme</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudPaper Class="mt-4 pa-4" Elevation="0" Style="border-radius:16px; background:#fef9c3;">
    <MudText Typo="Typo.subtitle1" Class="font-weight-bold" Style="color:#713f12;">Verset du jour pour les enfants</MudText>
    <MudText Typo="Typo.body1" Style="color:#713f12; font-style:italic; margin-top:8px;">
        "Laissez venir a moi les petits enfants, et ne les empechez pas; car le royaume de Dieu est pour ceux qui leur ressemblent." — Marc 10:14
    </MudText>
</MudPaper>