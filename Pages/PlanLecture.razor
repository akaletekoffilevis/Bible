@page "/plan-lecture"
@using BibleApp.Models
@using BibleApp.Services
@inject ReadingPlanService PlanService
@inject BibleApp.Services.IndexedDbService IndexedDb
@inject ISnackbar Snackbar

<Breadcrumb Nodes="@(new List<BreadcrumbNode> {
    new() { Label = "Accueil", Href = "/", Icon = Icons.Material.Filled.Home },
    new() { Label = "Plan de lecture" }
})" />

<div class="d-flex align-center justify-space-between mb-4" style="flex-wrap:wrap; gap:8px;">
    <MudText Typo="Typo.h6" Class="font-weight-bold d-flex align-center">
        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Class="mr-2" /> Plan de lecture
    </MudText>
    <MudText Typo="Typo.caption" Class="mud-text-secondary">
        Lire la Bible en 1 an
    </MudText>
</div>

@if (_plan == null)
{
    <MudPaper Class="pa-8 text-center" Elevation="0">
        @for (int i = 0; i < 4; i++)
        {
            <div class="skeleton-line mb-3" style="width: @(Random.Shared.Next(60, 100))%; height: 16px; margin: 0 auto;"></div>
        }
    </MudPaper>
}
else
{
    <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border-radius:12px;">
        <div class="d-flex align-center justify-space-between mb-3" style="flex-wrap:wrap; gap:8px;">
            <div>
                <MudText Typo="Typo.h5" Class="font-weight-bold mud-primary--text">Jour @_jourActuel / 365</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@_progressionText</MudText>
            </div>
            <div class="plan-streak" Style="background:var(--mud-palette-table-hover, rgba(0,0,0,0.04));">
                <MudIcon Icon="@Icons.Material.Filled.LocalFireDepartment" Size="Size.Small" Color="Color.Error" />
                <span>@_streak jour(s) d'affilée</span>
            </div>
        </div>

        <MudProgressLinear Value="@_pourcentage" Color="Color.Primary" Class="mb-2" />
    </MudPaper>

    @if (_lectureDuJour != null)
    {
        <MudText Typo="Typo.subtitle1" Class="mb-2 d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Today" Size="Size.Small" Class="mr-1" Color="Color.Primary" />
            Lecture du jour @(_lectureDuJour.EstFait ? "✅" : "📖")
        </MudText>

        <MudPaper Class="pa-3 mb-4" Elevation="0" Style="border-radius:12px; border: 2px solid var(--mud-palette-primary);">
            <MudGrid>
                @foreach (var lecture in _lectureDuJour.Lectures)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudPaper Class="pa-3 text-center" Elevation="0" Style="border-radius:10px; cursor:pointer;" @onclick="@(() => NavigationManager.NavigateTo(lecture.Url))">
                            <MudIcon Icon="@Icons.Material.Filled.AutoStories" Size="Size.Small" Color="Color.Primary" Class="mb-1" />
                            <MudText Typo="Typo.body2" Class="font-weight-medium">@lecture.Livre @lecture.Chapitre</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Clique pour lire</MudText>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
            <div class="d-flex justify-center mt-3" style="gap:8px;">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@MarquerLectureFaite" StartIcon="@Icons.Material.Filled.CheckCircle">
                    @(_lectureDuJour.EstFait ? "Déjà marqué" : "Marquer comme lu")
                </MudButton>
            </div>
        </MudPaper>
    }

    <MudText Typo="Typo.subtitle2" Class="mb-2">
        <MudIcon Icon="@Icons.Material.Filled.List" Size="Size.Small" Class="mr-1" /> Aperçu de la semaine
    </MudText>

    @foreach (var jour in _semaine)
    {
        <MudPaper Class="@GetDayCardClass(jour)" Elevation="0" Style="border-radius:10px;">
            <div class="d-flex align-center justify-space-between" style="flex-wrap:wrap; gap:4px;">
                <div class="d-flex align-center" style="gap:8px;">
                    <MudText Typo="Typo.body2" Class="font-weight-medium" Style="min-width:60px;">Jour @jour.Jour</MudText>
                    <div class="d-flex" style="gap:6px; flex-wrap:wrap;">
                        @foreach (var l in jour.Lectures)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" @onclick="@(() => NavigationManager.NavigateTo(l.Url))">
                                @l.Livre @l.Chapitre
                            </MudChip>
                        }
                    </div>
                </div>
                @if (jour.EstFait)
                {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" />
                }
            </div>
        </MudPaper>
    }

    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-3 text-center d-block">
        @_progressionText complétés
    </MudText>
}

@code {
    private List<LectureQuotidienne>? _plan;
    private int _jourActuel;
    private LectureQuotidienne? _lectureDuJour;
    private List<LectureQuotidienne> _semaine = new();
    private int _nbFaits;
    private int _pourcentage;
    private string _progressionText = "";
    private int _streak;
    private HashSet<int> _joursFaits = new();

    protected override async Task OnInitializedAsync()
    {
        await ChargerAsync();
    }

    private async Task ChargerAsync()
    {
        _plan = await PlanService.GetPlanAsync();
        _jourActuel = PlanService.JourActuel;
        if (_jourActuel > 365) _jourActuel = 365;
        _lectureDuJour = _plan.FirstOrDefault(p => p.Jour == _jourActuel);

        await ChargerProgressionAsync();

        var debutSemaine = Math.Max(1, _jourActuel - 3);
        var finSemaine = Math.Min(365, _jourActuel + 3);
        _semaine = _plan.Where(p => p.Jour >= debutSemaine && p.Jour <= finSemaine).ToList();
    }

    private async Task ChargerProgressionAsync()
    {
        try
        {
            await IndexedDb.InitializeAsync();
            var all = await IndexedDb.GetAllAsync<PlanJour>("planProgress");
            _joursFaits = all.Select(j => j.Jour).ToHashSet();

            _nbFaits = _joursFaits.Count;
            _pourcentage = (int)((double)_nbFaits / 365 * 100);
            _progressionText = PlanService.ProgressionTexte(_nbFaits);
            _streak = CalculerStreak();

            if (_lectureDuJour != null)
                _lectureDuJour.EstFait = _joursFaits.Contains(_jourActuel);

            foreach (var j in _semaine)
                j.EstFait = _joursFaits.Contains(j.Jour);
        }
        catch (Exception ex) { Console.Error.WriteLine($"[Plan] Échec chargement progression: {ex.Message}"); }
    }

    private int CalculerStreak()
    {
        var streak = 0;
        var aujourdhui = DateTime.UtcNow.Date;
        for (int i = 0; i < 365; i++)
        {
            var jour = (aujourdhui.AddDays(-i) - new DateTime(aujourdhui.Year, 1, 1)).Days + 1;
            if (jour < 1) break;
            if (_joursFaits.Contains(jour))
                streak++;
            else if (i > 0)
                break;
        }
        return streak;
    }

    private async Task MarquerLectureFaite()
    {
        if (_lectureDuJour == null || _lectureDuJour.EstFait) return;
        try
        {
            await IndexedDb.InitializeAsync();
            await IndexedDb.PutAsync("planProgress", $"jour-{_jourActuel}",
                new PlanJour { Id = $"jour-{_jourActuel}", Jour = _jourActuel, Date = DateTime.UtcNow.ToString("yyyy-MM-dd") });
            _lectureDuJour.EstFait = true;
            _joursFaits.Add(_jourActuel);
            _nbFaits = _joursFaits.Count;
            _pourcentage = (int)((double)_nbFaits / 365 * 100);
            _progressionText = PlanService.ProgressionTexte(_nbFaits);
            _streak = CalculerStreak();
            Snackbar.Add("✓ Jour marqué comme lu !", Severity.Success);
        }
        catch { Snackbar.Add("Erreur de sauvegarde", Severity.Error); }
    }

    private string GetDayCardClass(LectureQuotidienne jour)
    {
        var classes = "pa-3 mb-2 plan-day-card";
        if (jour.EstFait) classes += " done";
        if (jour.Jour == _jourActuel) classes += " today";
        return classes;
    }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = null!;
}
