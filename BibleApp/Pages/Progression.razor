@page "/progression"
@using BibleApp.Models
@using BibleApp.Services
@inject BibleApp.Services.BibleService BibleService
@inject IndexedDbService IndexedDb

<Breadcrumb Nodes="@(new List<BreadcrumbNode> {
    new() { Label = "Accueil", Href = "/", Icon = Icons.Material.Filled.Home },
    new() { Label = "Ma progression" }
})" />

<MudText Typo="Typo.h6" Class="mb-4 font-weight-bold d-flex align-center">
    <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Class="mr-2" /> Ma progression
</MudText>

@if (_index.Count == 0)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Indeterminate />
    </div>
}
else
{
    <MudPaper Class="pa-4 mb-4 text-center" Elevation="0" Style="border-radius: 8px; background: linear-gradient(135deg, var(--mud-palette-primary) 0%, var(--mud-palette-secondary) 100%); color: white;">
        <MudText Typo="Typo.h4" Class="mb-1">@_totalChapitresLus / @_totalChapitres</MudText>
        <MudText Typo="Typo.body2" Class="mb-3" Style="opacity:0.9;">chapitres lus</MudText>
        <MudProgressLinear Value="@_totalProgress" Color="Color.Info" Class="mb-2" Style="background: rgba(255,255,255,0.2);" />
        <MudText Typo="Typo.caption" Style="opacity:0.8;">@_totalProgress.ToString("0.0")% de la Bible</MudText>
    </MudPaper>

    <MudPaper Class="pa-3" Elevation="0">
        <MudText Typo="Typo.subtitle2" Class="mb-2 d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.AutoStories" Size="Size.Small" Class="mr-1" />
            Ancien Testament
            <MudProgressLinear Value="@_atProgress" Color="Color.Primary" Class="ml-2" Style="flex:1; max-width: 120px;" />
            <MudText Typo="Typo.caption" Class="ml-2 mud-text-secondary">@_atProgress.ToString("0.0")%</MudText>
        </MudText>
        @foreach (var livre in _index.Where(l => l.Testament.StartsWith("Ancien")))
        {
            <div class="d-flex align-center mb-2" Style="gap:8px;">
                <MudText Typo="Typo.body2" Class="flex-shrink-0" Style="min-width:110px;">@livre.NomLivre</MudText>
                <div style="flex:1;">
                    <MudProgressLinear Value="@GetProgress(livre.Slug)" Size="Size.Small" />
                </div>
                <MudText Typo="Typo.caption" Class="mud-text-secondary flex-shrink-0" Style="min-width:36px; text-align:right;">
                    @GetChapitresLus(livre.Slug)/@livre.NombreChapitres
                </MudText>
            </div>
        }

        <MudDivider Class="my-3" />

        <MudText Typo="Typo.subtitle2" Class="mb-2 d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.AutoStories" Size="Size.Small" Class="mr-1" />
            Nouveau Testament
            <MudProgressLinear Value="@_ntProgress" Color="Color.Secondary" Class="ml-2" Style="flex:1; max-width: 120px;" />
            <MudText Typo="Typo.caption" Class="ml-2 mud-text-secondary">@_ntProgress.ToString("0.0")%</MudText>
        </MudText>
        @foreach (var livre in _index.Where(l => l.Testament.StartsWith("Nouveau")))
        {
            <div class="d-flex align-center mb-2" Style="gap:8px;">
                <MudText Typo="Typo.body2" Class="flex-shrink-0" Style="min-width:110px;">@livre.NomLivre</MudText>
                <div style="flex:1;">
                    <MudProgressLinear Value="@GetProgress(livre.Slug)" Size="Size.Small" />
                </div>
                <MudText Typo="Typo.caption" Class="mud-text-secondary flex-shrink-0" Style="min-width:36px; text-align:right;">
                    @GetChapitresLus(livre.Slug)/@livre.NombreChapitres
                </MudText>
            </div>
        }
    </MudPaper>
}

@code {
    private List<BibleApp.Models.LivreIndex> _index = new();
    private Dictionary<string, HashSet<int>> _lus = new();
    private int _totalChapitres;
    private int _totalChapitresLus;

    private double _totalProgress => _totalChapitres > 0 ? (double)_totalChapitresLus / _totalChapitres * 100 : 0;
    private double _atProgress => GetTestamentProgress("Ancien");
    private double _ntProgress => GetTestamentProgress("Nouveau");

    protected override async Task OnInitializedAsync()
    {
        _index = await BibleService.GetIndexAsync();
        await IndexedDb.InitializeAsync();
        var history = await IndexedDb.GetAllAsync<ProgressEntry>("progress");
        _lus = history
            .GroupBy(h => h.slug)
            .ToDictionary(g => g.Key, g => g.Select(h => h.chapitre).ToHashSet());

        _totalChapitres = _index.Sum(l => l.NombreChapitres);
        _totalChapitresLus = _index.Sum(l =>
        {
            if (!_lus.TryGetValue(l.Slug, out var c)) return 0;
            return Math.Min(c.Count, l.NombreChapitres);
        });
    }

    private double GetTestamentProgress(string prefix)
    {
        var livres = _index.Where(l => l.Testament.StartsWith(prefix)).ToList();
        var total = livres.Sum(l => l.NombreChapitres);
        var lus = livres.Sum(l =>
        {
            if (!_lus.TryGetValue(l.Slug, out var c)) return 0;
            return Math.Min(c.Count, l.NombreChapitres);
        });
        return total > 0 ? (double)lus / total * 100 : 0;
    }

    private double GetProgress(string slug)
    {
        var livre = _index.FirstOrDefault(l => l.Slug == slug);
        if (livre == null) return 0;
        if (!_lus.TryGetValue(slug, out var chapitresLus)) return 0;
        return (double)Math.Min(chapitresLus.Count, livre.NombreChapitres) / livre.NombreChapitres * 100;
    }

    private int GetChapitresLus(string slug)
    {
        if (!_lus.TryGetValue(slug, out var c)) return 0;
        var livre = _index.FirstOrDefault(l => l.Slug == slug);
        return livre != null ? Math.Min(c.Count, livre.NombreChapitres) : c.Count;
    }

    public class ProgressEntry
    {
        public string id { get; set; } = string.Empty;
        public string slug { get; set; } = string.Empty;
        public int chapitre { get; set; }
    }
}
