@namespace BibleApp.Shared
@inject BibleApp.Services.BibleService BibleService
@inject IJSRuntime JsRuntime
@implements IDisposable

<div class="nav-root">
    <!-- Brand -->
    <div class="nav-brand">
        <MudIcon Icon="@Icons.Material.Filled.MenuBook" Color="Color.Primary" />
        <span class="nav-brand-text">Bibeli</span>
    </div>

    <!-- Quick filter -->
    <div class="nav-search">
        <MudTextField @bind-Value="_filter"
                      Placeholder="Filtrer les livres..."
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Class="nav-search-field" />
    </div>

    <!-- Quick links -->
    <div class="nav-quick">
        <a href="/" class="nav-quick-btn" @onclick="NotifyNavigated"><MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Small" /><span>Accueil</span></a>
        <a href="/recherche" class="nav-quick-btn" @onclick="NotifyNavigated"><MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" /><span>Recherche</span></a>
        <a href="/concordance" class="nav-quick-btn" @onclick="NotifyNavigated"><MudIcon Icon="@Icons.Material.Filled.LibraryBooks" Size="Size.Small" /><span>Thèmes</span></a>
        <a href="/memorisation" class="nav-quick-btn" @onclick="NotifyNavigated"><MudIcon Icon="@Icons.Material.Filled.Style" Size="Size.Small" /><span>Mémoriser</span></a>
        <a href="/statistiques" class="nav-quick-btn" @onclick="NotifyNavigated"><MudIcon Icon="@Icons.Material.Filled.Insights" Size="Size.Small" /><span>Stats</span></a>
        <a href="/quiz" class="nav-quick-btn" @onclick="NotifyNavigated"><MudIcon Icon="@Icons.Material.Filled.Quiz" Size="Size.Small" /><span>Quiz</span></a>
        <a href="/enfant" class="nav-quick-btn" @onclick="NotifyNavigated"><MudIcon Icon="@Icons.Material.Filled.ChildCare" Size="Size.Small" /><span>Enfant</span></a>
        <a href="/parametres" class="nav-quick-btn" @onclick="NotifyNavigated"><MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" /><span>Réglages</span></a>
    </div>

    <MudDivider Class="my-2" />

    <!-- Testaments -->
    @foreach (var (titre, expanded, toggle, livres) in new[] {
        ("Ancien Testament", _atExpanded, (Action)(() => _atExpanded = !_atExpanded), _livresAt.ToList()),
        ("Nouveau Testament", _ntExpanded, (Action)(() => _ntExpanded = !_ntExpanded), _livresNt.ToList())
    })
    {
        <div class="nav-section">
            <button class="nav-section-header" @onclick="toggle">
                <MudIcon Icon="@(expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
                <span>@titre</span>
                <span class="nav-section-count">@livres.Count</span>
            </button>
            @if (expanded || !string.IsNullOrEmpty(_filter))
            {
                <div class="nav-book-grid">
                    @foreach (var livre in livres)
                    {
                        <a href="@($"/lecture/{livre.Slug}/1")" class="nav-book" @onclick="NotifyNavigated" title="@livre.NomLivre">
                            <span class="nav-book-abbr">@Abréviation(livre.NomLivre)</span>
                            <span class="nav-book-name">@livre.NomLivre</span>
                        </a>
                    }
                </div>
                @if (!livres.Any())
                {
                    <div class="nav-empty">Aucun livre trouvé</div>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public EventCallback OnNavigated { get; set; }

    private List<BibleApp.Models.LivreIndex> _index = new();
    private bool _atExpanded = true;
    private bool _ntExpanded = false;
    private string _filter = string.Empty;
    private bool _pwaInstalled;

    private IEnumerable<BibleApp.Models.LivreIndex> _livresAt =>
        _index.Where(l => l.Testament.StartsWith("Ancien") && l.NomLivre.Contains(_filter, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<BibleApp.Models.LivreIndex> _livresNt =>
        _index.Where(l => l.Testament.StartsWith("Nouveau") && l.NomLivre.Contains(_filter, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        _index = await BibleService.GetIndexAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { _pwaInstalled = await JsRuntime.InvokeAsync<bool>("bibleInstall.isInstalled"); StateHasChanged(); }
            catch { }
        }
    }

    private async Task InstallerPwa()
    {
        try
        {
            var ok = await JsRuntime.InvokeAsync<bool>("bibleInstall.promptInstall");
            if (ok) { _pwaInstalled = true; NotifyNavigated(); }
        }
        catch { }
    }

    private void NotifyNavigated() => OnNavigated.InvokeAsync();

    private static string Abréviation(string nom) => nom switch
    {
        "Genèse" => "Gn", "Exode" => "Ex", "Lévitique" => "Lv", "Nombres" => "Nb",
        "Deutéronome" => "Dt", "Josué" => "Js", "Juges" => "Jg", "Ruth" => "Rt",
        "1 Samuel" => "1S", "2 Samuel" => "2S", "1 Rois" => "1R", "2 Rois" => "2R",
        "1 Chroniques" => "1Ch", "2 Chroniques" => "2Ch", "Esdras" => "Esd",
        "Néhémie" => "Né", "Esther" => "Est", "Job" => "Jb", "Psaumes" => "Ps",
        "Proverbes" => "Pr", "Ecclésiaste" => "Ec", "Cantique des cantiques" => "Ct",
        "Esaïe" => "Es", "Jérémie" => "Jr", "Lamentations de Jérémie" => "Lm",
        "Ezéchiel" => "Ez", "Daniel" => "Dn", "Osée" => "Os", "Joël" => "Jl",
        "Amos" => "Am", "Abdias" => "Ab", "Jonas" => "Jon", "Michée" => "Mi",
        "Nahum" => "Na", "Habacuc" => "Ha", "Sophonie" => "So", "Aggée" => "Ag",
        "Zacharie" => "Za", "Malachie" => "Ml",
        "Matthieu" => "Mt", "Marc" => "Mc", "Luc" => "Lc", "Jean" => "Jn",
        "Actes des Apôtres" => "Ac", "Romains" => "Rm", "1 Corinthiens" => "1Co",
        "2 Corinthiens" => "2Co", "Galates" => "Ga", "Ephésiens" => "Ep",
        "Philippiens" => "Ph", "Colossiens" => "Col", "1 Thessaloniciens" => "1Th",
        "2 Thessaloniciens" => "2Th", "1 Timothée" => "1Tm", "2 Timothée" => "2Tm",
        "Tite" => "Tt", "Philémon" => "Phm", "Hébreux" => "Hé", "Jacques" => "Jc",
        "1 Pierre" => "1Pi", "2 Pierre" => "2Pi", "1 Jean" => "1Jn", "2 Jean" => "2Jn",
        "3 Jean" => "3Jn", "Jude" => "Jude", "Apocalypse" => "Ap",
        _ => nom[..Math.Min(3, nom.Length)]
    };

    public void Dispose() { }
}