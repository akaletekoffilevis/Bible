@namespace BibleApp.Shared
@inject BibleApp.Services.BibleService BibleService
@inject NavigationManager Nav

<MudNavMenu Class="pb-16" Style="overflow-y:auto; max-height: calc(100vh - 64px);">
    <MudTextField @bind-Value="_filter"
                  Label="Filtrer les livres..."
                  Variant="Variant.Outlined"
                  Immediate="true"
                  Class="ma-3"
                  Margin="Margin.Dense"
                  Adornment="Adornment.End"
                  AdornmentIcon="@Icons.Material.Filled.Search" />

    <div class="d-flex flex-wrap px-3" style="gap:4px;">
        <MudChip T="string" Size="Size.Small" OnClick="@(() => { Nav.NavigateTo("/"); NotifyNavigated(); })" Icon="@Icons.Material.Filled.Home">Accueil</MudChip>
        <MudChip T="string" Size="Size.Small" OnClick="@(() => { Nav.NavigateTo("/recherche"); NotifyNavigated(); })" Icon="@Icons.Material.Filled.Search">Recherche</MudChip>
        <MudChip T="string" Size="Size.Small" OnClick="@(() => { Nav.NavigateTo("/quiz"); NotifyNavigated(); })" Icon="@Icons.Material.Filled.Quiz">Quiz</MudChip>
        <MudChip T="string" Size="Size.Small" OnClick="@(() => { Nav.NavigateTo("/carte"); NotifyNavigated(); })" Icon="@Icons.Material.Filled.Map">Carte</MudChip>
    </div>

    <MudDivider Class="my-2" />

    <MudText Typo="Typo.subtitle2" Class="px-3 py-2 d-flex align-center" Style="cursor:pointer;user-select:none;" @onclick="@(() => _atExpanded = !_atExpanded)">
        <MudIcon Icon="@(_atExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" Class="mr-1" />
        <span class="flex-grow-1">Ancien Testament</span>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@_atCount</MudText>
    </MudText>
    @if (_atExpanded || !string.IsNullOrEmpty(_filter))
    {
        <div class="px-2" style="column-count:2; column-gap:4px;">
        @foreach (var livre in _livresAt)
        {
            <MudNavLink Href="@($"/lecture/{livre.Slug}/1")" Match="NavLinkMatch.Prefix" OnClick="NotifyNavigated" Class="py-1" Style="font-size:0.85rem;break-inside:avoid;">
                <span class="mud-text-secondary" style="font-size:0.75rem;width:32px;display:inline-block;">@Abréviation(livre.NomLivre)</span> @livre.NomLivre
            </MudNavLink>
        }
        </div>
    }

    <MudDivider Class="my-2" />

    <MudText Typo="Typo.subtitle2" Class="px-3 py-2 d-flex align-center" Style="cursor:pointer;user-select:none;" @onclick="@(() => _ntExpanded = !_ntExpanded)">
        <MudIcon Icon="@(_ntExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" Class="mr-1" />
        <span class="flex-grow-1">Nouveau Testament</span>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@_ntCount</MudText>
    </MudText>
    @if (_ntExpanded || !string.IsNullOrEmpty(_filter))
    {
        <div class="px-2" style="column-count:2; column-gap:4px;">
        @foreach (var livre in _livresNt)
        {
            <MudNavLink Href="@($"/lecture/{livre.Slug}/1")" Match="NavLinkMatch.Prefix" OnClick="NotifyNavigated" Class="py-1" Style="font-size:0.85rem;break-inside:avoid;">
                <span class="mud-text-secondary" style="font-size:0.75rem;width:32px;display:inline-block;">@Abréviation(livre.NomLivre)</span> @livre.NomLivre
            </MudNavLink>
        }
        </div>
    }

    <MudDivider Class="my-2" />

    <div class="d-flex flex-wrap px-3" style="gap:4px;">
        <MudChip T="string" Size="Size.Small" OnClick="@(() => { Nav.NavigateTo("/favoris"); NotifyNavigated(); })" Icon="@Icons.Material.Filled.Bookmark">Favoris</MudChip>
        <MudChip T="string" Size="Size.Small" OnClick="@(() => { Nav.NavigateTo("/progression"); NotifyNavigated(); })" Icon="@Icons.Material.Filled.TrendingUp">Progression</MudChip>
        <MudChip T="string" Size="Size.Small" OnClick="@(() => { Nav.NavigateTo("/parametres"); NotifyNavigated(); })" Icon="@Icons.Material.Filled.Settings">Paramètres</MudChip>
    </div>
</MudNavMenu>

@code {
    [Parameter]
    public EventCallback OnNavigated { get; set; }

    private List<BibleApp.Models.LivreIndex> _index = new();
    private bool _atExpanded = true;
    private bool _ntExpanded = true;
    private string _filter = string.Empty;

    private IEnumerable<BibleApp.Models.LivreIndex> _livresAt =>
        _index.Where(l => l.Testament.StartsWith("Ancien") && l.NomLivre.Contains(_filter, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<BibleApp.Models.LivreIndex> _livresNt =>
        _index.Where(l => l.Testament.StartsWith("Nouveau") && l.NomLivre.Contains(_filter, StringComparison.OrdinalIgnoreCase));

    private int _atCount => _index.Count(l => l.Testament.StartsWith("Ancien"));
    private int _ntCount => _index.Count(l => l.Testament.StartsWith("Nouveau"));

    protected override async Task OnInitializedAsync()
    {
        _index = await BibleService.GetIndexAsync();
    }

    private void NotifyNavigated()
    {
        OnNavigated.InvokeAsync();
    }

    private static string Abréviation(string nom)
    {
        return nom switch
        {
            "Genèse" => "Gn", "Exode" => "Ex", "Lévitique" => "Lv", "Nombres" => "Nb",
            "Deutéronome" => "Dt", "Josué" => "Js", "Juges" => "Jg", "Ruth" => "Rt",
            "1 Samuel" => "1S", "2 Samuel" => "2S", "1 Rois" => "1R", "2 Rois" => "2R",
            "1 Chroniques" => "1Ch", "2 Chroniques" => "2Ch", "Esdras" => "Esd",
            "Néhémie" => "Né", "Esther" => "Est", "Job" => "Jb", "Psaumes" => "Ps",
            "Proverbes" => "Pr", "Ecclésiaste" => "Ec", "Cantique des cantiques" => "Ct",
            "Esaïe" => "Es", "Jérémie" => "Jr", "Lamentations de Jérémie" => "Lm",
            "Ezéchiel" => "Ez", "Daniel" => "Dn", "Osée" => "Os", "Joël" => "Jl",
            "Amos" => "Am", "Abdias" => "Ab", "Jonas" => "Jon", "Michée" => "Mi",
            "Nahum" => "Na", "Habacuc" => "Ha", "Sophonie" => "So", "Aggée" => "Ag",
            "Zacharie" => "Za", "Malachie" => "Ml",
            "Matthieu" => "Mt", "Marc" => "Mc", "Luc" => "Lc", "Jean" => "Jn",
            "Actes des Apôtres" => "Ac", "Romains" => "Rm", "1 Corinthiens" => "1Co",
            "2 Corinthiens" => "2Co", "Galates" => "Ga", "Ephésiens" => "Ep",
            "Philippiens" => "Ph", "Colossiens" => "Col", "1 Thessaloniciens" => "1Th",
            "2 Thessaloniciens" => "2Th", "1 Timothée" => "1Tm", "2 Timothée" => "2Tm",
            "Tite" => "Tt", "Philémon" => "Phm", "Hébreux" => "Hé", "Jacques" => "Jc",
            "1 Pierre" => "1Pi", "2 Pierre" => "2Pi", "1 Jean" => "1Jn", "2 Jean" => "2Jn",
            "3 Jean" => "3Jn", "Jude" => "Jude", "Apocalypse" => "Ap",
            _ => nom[..3]
        };
    }
}
