@namespace BibleApp.Shared
@using MudBlazor
@using BibleApp.Services
@inject IndexedDbService IndexedDb
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.NoteAdd" Class="mr-2" Size="Size.Small" />
            Note — @Reference
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_texte"
                      Label="Ta note..."
                      Variant="Variant.Outlined"
                      Lines="4"
                      FullWidth="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Annuler</MudButton>
        <MudButton OnClick="Save" Variant="Variant.Filled" Color="Color.Primary" Disabled="string.IsNullOrWhiteSpace(_texte)">
            Enregistrer
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string Reference { get; set; } = string.Empty;
    [Parameter] public string Id { get; set; } = string.Empty;
    [Parameter] public string Slug { get; set; } = string.Empty;
    [Parameter] public int Chapitre { get; set; }
    [Parameter] public int VersetNumero { get; set; }

    private string _texte = string.Empty;

    private void Cancel() => MudDialog.Cancel();

    private async Task Save()
    {
        try
        {
            await IndexedDb.InitializeAsync();
            await IndexedDb.PutAsync("notes", Id, new
            {
                id = Id,
                reference = Reference,
                texte = _texte
            });
            Snackbar.Add("✓ Note enregistrée", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch
        {
            Snackbar.Add("Erreur lors de l'enregistrement", Severity.Error);
            MudDialog.Cancel();
        }
    }
}
